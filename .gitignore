# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local npm cache. .npmrc points npm here so it never writes outside the project.
.npmcache/

# Secrets. .env holds NCBI_API_KEY. The server reads it only when launched
# with --env-file-if-exists=.env, which npm start and npm run dev pass.
.env
.env.*

# Tool scratch. The MCP Inspector writes its catalog here.
.mcp-inspector/
coverage/
*.log

# Reference material. The NCBI E-utilities manual is copyrighted and lives at
# https://www.ncbi.nlm.nih.gov/books/NBK25501/ — link it, do not vendor it.
E-utilities.pdf

# Local-only notes. evals/HANDOFF.md documents this machine's harness setup
# with absolute local paths. Others don't need it; the tracked
# evals/eutils_evaluation.xml plus scripts/verify-evals.mjs are the
# reproducible part of the evaluation.
evals/HANDOFF.md

# Local-only design record. The approved 2026-09-11 spec drove this
# implementation, but it is working notes, not user documentation.
# It stays on disk and out of version control.
docs/superpowers/

# OS noise
.DS_Store
Thumbs.db
