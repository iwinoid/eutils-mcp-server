{
  "name": "eutils-mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing the nine NCBI Entrez E-utilities as eleven read-only tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "eutils-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "npm run build && EUTILS_LIVE=1 node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run test/live.test.ts",
    "verify": "npm run build && node --env-file-if-exists=.env scripts/verify-server.mjs",
    "verify:live": "npm run build && node --env-file-if-exists=.env scripts/verify-server.mjs --live",
    "call": "node --env-file-if-exists=.env scripts/call-tool.mjs",
    "verify:evals": "npm run build && node --env-file-if-exists=.env scripts/verify-evals.mjs",
    "refresh:databases": "node --env-file-if-exists=.env scripts/refresh-databases.mjs",
    "clean": "rm -rf dist",
    "doctor": "npm run build && node --env-file-if-exists=.env scripts/doctor.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "fast-xml-parser": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.0.0"
  }
}
